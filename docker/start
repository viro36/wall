#!/bin/bash
set -e

# Создаем директории если их нет
mkdir -p /App/staticfiles /App/mediafiles

# Собираем статику (теперь при каждом запуске)
python manage.py collectstatic --noinput --clear

# Применяем миграции
python manage.py migrate --noinput

# Создаем superuser если нет
python manage.py shell -c "
from django.contrib.auth import get_user_model;
User = get_user_model();
if not User.objects.filter(is_superuser=True).exists():
    User.objects.create_superuser('admin', 'admin@example.com', 'admin123')
    print('Superuser created')
"

# Создаем директорию для управляющих файлов
mkdir -p /tmp/gunicorn
chmod 755 /tmp/gunicorn

exec gunicorn witwall.wsgi:application \
    --bind 0.0.0.0:8000 \
    --workers 4 \
    --worker-class sync \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    --pid /tmp/gunicorn.pid \
    --worker-tmp-dir /dev/shm
